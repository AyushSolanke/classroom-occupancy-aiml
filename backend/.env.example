# Smart Classroom Occupancy Detection Configuration

# Database Connection (SQLite by default, easily replaceable with PostgreSQL)
DATABASE_URL=sqlite:///./smart_classroom.db

# Ultralytics YOLOv8 Model Weights Path
MODEL_PATH=models/yolov8n.pt

# Object Detection Hyperparameters
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Video Processing Frame Sample Rate (process every Nth frame)
PROCESS_EVERY_N_FRAMES=5

# Classroom Occupancy Status Thresholds (Percentages)
LOW_OCCUPANCY_THRESHOLD=35.0
MODERATE_OCCUPANCY_THRESHOLD=80.0
FULL_OCCUPANCY_THRESHOLD=95.0

# Energy Management Estimations (Clearly labeled as estimated)
ENERGY_LIGHTING_KW_PER_ROOM=0.6
ENERGY_HVAC_KW_PER_ROOM=3.0
ENERGY_COST_PER_KWH=8.0

# Dashboard Real-Time Polling Interval (in milliseconds)
REALTIME_UPDATE_INTERVAL_MS=3000

# Optional AI Assistant / LLM Key (Google Gemini / OpenAI compatible)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
